# Copy to .env.local. For local development, `pnpm db:start` prints the values to use.

# Supabase project URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key, safe in the browser because RLS protects every table.
# Local: the "Publishable" key from `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection used by Drizzle on the server only. Queries run as the signed-in person (RLS applies).
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: the transaction pooler URL (port 6543) from Supabase > Connect
DATABASE_URL=
