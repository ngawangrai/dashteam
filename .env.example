# Every setting below is required: the app refuses to build or start without one, and names it.
# Locally, `pnpm env:local` writes all of them from the running Supabase stack.
# On Vercel, set them for Production only. Preview and Development get none (a preview refuses to run).

# Supabase project URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key, safe in the browser because RLS protects every table.
# Local: the "Publishable" key from `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection used by Drizzle on the server only. Queries run as the signed-in person (RLS applies).
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: the transaction pooler URL (port 6543) from Supabase > Connect
DATABASE_URL=

# Server only, never NEXT_PUBLIC. Creates and removes logins when an admin adds people.
# Local: the "Secret" key from `pnpm exec supabase status`. Hosted: Supabase > Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# Encrypts TPN and bank account numbers. 32 random bytes: `openssl rand -base64 32`.
# Use a different key per environment, and keep the production key in your password manager:
# without it, those fields in the database and in every backup cannot be read.
FIELD_ENCRYPTION_KEY=

# How email is sent: set exactly one of these two.
# Production: a Resend (https://resend.com) API key with sending access only. Server only.
RESEND_API_KEY=
# Local development and CI: the Mailpit the Supabase stack runs. Local: http://127.0.0.1:54324
MAILPIT_URL=

# Who emails come from. In production, on a domain verified in Resend. Example: Xceed Studio <payroll@xceed.studio>
EMAIL_FROM=

# The app's address, for links in emails. Local: http://localhost:3000
APP_URL=

# The daily TDS filing reminder job (.github/workflows/filing-reminders.yml) sends this as a bearer
# token. At least 32 random characters: `openssl rand -hex 32`. Set the same value as the GitHub secret.
CRON_SECRET=
