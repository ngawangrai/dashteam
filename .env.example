# Copy to .env.local. For local development, `pnpm db:start` prints the values to use.

# Supabase project URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key, safe in the browser because RLS protects every table.
# Local: the "Publishable" key from `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection used by Drizzle on the server only. Queries run as the signed-in person (RLS applies).
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: the transaction pooler URL (port 6543) from Supabase > Connect
DATABASE_URL=

# Server only, never NEXT_PUBLIC. Creates and removes logins when an admin adds people.
# Local: the "Secret" key from `pnpm exec supabase status`. Hosted: Supabase > Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# Encrypts TPN and bank account numbers. 32 random bytes: `openssl rand -base64 32`.
# Use a different key per environment, and keep the production key in your password manager:
# without it, those fields in the database and in every backup cannot be read.
FIELD_ENCRYPTION_KEY=

# Email through Resend (https://resend.com). Server only. Without it, local development sends to
# Mailpit (http://127.0.0.1:54324) and production marks each email "not set up yet" so it can be retried.
RESEND_API_KEY=

# Who emails come from. Must be on a domain verified in Resend. Example: Xceed Studio <payroll@xceed.studio>
EMAIL_FROM=

# The app's address, for links in emails. Local: http://localhost:3000
APP_URL=
